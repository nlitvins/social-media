type User {
    id: ID!
    userName: String!
}

type Post {
    id: ID!
    author: User!
    content: String!
    creationTime: String!
}

type Comment{
    id: ID!
    author: User!
    post: Post!
    content: String!
    creationTime: String!
}

type Query{
    test: String
    users: [User!]!
    posts: [Post!]!
    comments: [Comment!]!
    user(id: ID!): User
    post(id: ID!): Post
    comment(id: ID!): Comment
}

type Mutation{
    createUser(userName: String!): User!
    createPost(content: String!, authorId: ID!): Post!
    createComment(content: String!, postId: ID!, authorId: ID!): Comment!
}




